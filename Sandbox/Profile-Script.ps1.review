######## FUNCTIONS ##########
function hh ( $term ) { get-help $term -full | more.com }
function ch {ghy | select -exp commandline | ogv -outp M | iex}   #GUI command history
function ns {net statistics workstation} # workstation net traffic information
function get-cpuspeed { get-wmiobject -query "SELECT CurrentClockSpeed FROM Win32_Processor" | fl CurrentClockSpeed }
function sync-time { w32tm.exe /resync }
function find-files ($pattern = "*", $searchroot = ".") { dir -r $searchroot | where {$_.fullname -like $pattern} | ft fullname }
function ip { ipconfig.exe | select-string 'IPv4|IPv6|^[^\s].+\:$|Subnet|Gateway' | select-string -Pattern "Tunnel" -NotMatch } # current IP
function uu ($user) {Unlock-ADAccount $user} #UU - Unlock User
function OSVer {gwmi Win32_OperatingSystem}  #get OS version and other info
function DNSList {Resolve-DnsName -Type ALL -Name _ldap._tcp.dc._msdcs.$env:userdnsdomain} # List all DCs
function Clip-History {(Get-History).CommandLine | clip.exe}   #Command Line Hisotry to Clipboard
function Drive-Info {Get-PSDrive -PSProvider FileSystem | Where-Object {$_.Used -gt 0} |
                     Select-Object -Property Root,@{Name="SizeGB";Expression={($_.Used+$_.free)/1GB -as [int]}},
                     @{name="UsedGB";Expression={($_.used/1GB) -as [int]}},
                     @{name="FreeGB";Expression={($_.free/1GB) -as [int]}},
                     @{name="PctFree";Expression={[math]::Round(($_.Free/($_.Used+$_.Free))*100,2)}}}
function App-Info {gcim win32_product -computername $env:computername | 
                   Sort-Object -property Vendor,Name |
                   Select-Object -property Vendor,Name,
                   @{Name="Installed";Expression = {($_.InstallDate.Insert(4,"-").insert(7,"-") -as [datetime]).ToShortDateString()}},
                   InstallLocation,InstallSource,PackageName,Version}  #Installed Apps
function List-Functions {Get-ChildItem function:\}

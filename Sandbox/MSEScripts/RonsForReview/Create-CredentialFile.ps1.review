Function Get-HashFileName($initialDirectory)
  {   
    [System.Reflection.Assembly]::LoadWithPartialName("System.windows.forms") 
    $OpenFileDialog = New-Object System.Windows.Forms.OpenFileDialog
    $OpenFileDialog.initialDirectory = $initialDirectory
    $OpenFileDialog.filter = "All files (*.*)| *.*"
    $OpenFileDialog.ShowDialog()
    $OpenFileDialog.filename
  } #end function Get-FileName

Function Get-SaveFile($initialDirectory)
  { 
    Add-Type -AssemblyName System.Windows.Forms
    $SaveFileDialog = New-Object System.Windows.Forms.SaveFileDialog
    $SaveFileDialog.initialDirectory = $initialDirectory
    $SaveFileDialog.filter = "All files (*.*)| *.*"
    $SaveFileDialog.ShowDialog()
    $SaveFileDialog.filename
  } 
  
Import-Module ac*


# Get ID and Password to Hash
$NewCred = $host.ui.PromptForCredential("Need Credentials for Hash File", "Please enter your user name and password.", "", "")
$NewCred.GetNetworkCredential()

# Get the location and name of the password hash file
$OutputFile = Get-SaveFile -initialDirectory "\\usstll0032\msedeployment\"
$Credential = $NewCred.Password | ConvertFrom-SecureString  | Set-Content $OutputFile

# Testing the process in reverse.

$TempPassword = Get-Content $OutputFile | Select-Object -first 1 | ConvertTo-SecureString
$TestCred = New-Object System.Management.Automation.PsCredential($NewCred.UserName,$TempPassword)
$TempPassword = $TestCred.GetNetworkCredential().password

Add-Type -AssemblyName System.DirectoryServices.AccountManagement
$ct = [System.DirectoryServices.AccountManagement.ContextType]::Domain
$pc = New-Object System.DirectoryServices.AccountManagement.PrincipalContext($ct, "NESTLE")
if ($pc.ValidateCredentials($NewCred.UserName, $TempPassword)) 
  {
    Write-Host "The password was saved correctly for $($NewCred.UserName)."
  }
else  
  {
    Write-Host "The password was NOT saved correctly for $($NewCred.UserName)."
  }
 


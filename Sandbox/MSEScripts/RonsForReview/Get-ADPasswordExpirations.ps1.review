<#


TITLE:           Get-ADPasswordExpirations.ps1

AUTHOR:	         Ron Gines

SUBMISSION DATE: 2014/08/01

PURPOSE: 
Some of the departments in Engineering are going to use this script.   Its only input 
is the number of days until expration.   It assumes that we are living off of the 1 year
expiration date for our service and plant floor logon accounts.   It will run a report
against your configured OU (modifyable in the script) and will report on the users name, 
what department is responsible for the password update (based on the department field in 
the ID AD entry being filled out) the last date the password was changed, the nuber of days 
until the password must be changed to meet compliance and the target date for that 
change.   The output at this time is in a simple formatted table.   This can obviously 
be changed to anything that you want.

SYNTAX:          Just run the script with a default of 90 Days.   Or add the parameter 
                 -Days in order to change the days until expiration that the report will 
                 filter on.

CUSTOMIZATION:   You will need to change the SearchBase variable to point to your OU.

#>

[CmdletBinding()]
param(
   [Decimal]$Days = 90
) 

Import-Module ActiveDirectory

$SearchBase = "OU=US-StLouis-HQ,OU=LMS Users and Groups,OU=NPPC AMS,OU=AMS,OU=Organizations,DC=nestle,dc=com"

$UserList = get-aduser -searchbase $searchbase -filter * | 
  where {$_.Enabled -eq "True"} |
  select -expand SamAccountName |
  get-aduser -properties * | 
  where { (Get-Date).AddDays($Days-364) -gt $_.passwordlastset} | 
  select SamAccountName, 
         Department, 
         @{n='PWLastSetDate';e={$_.PasswordLastSet.ToShortDateString()}},
         @{n='DaysTill';e={((Get-Date $_.PasswordLastSet.AddDays(364)) - (Get-Date)).Days}},
         @{n='SchedChangeDate';e={$_.PasswordLastSet.AddDays(364).ToShortDateString()}},
         Description,
         @{n='ShortDescription';e={$_.Description.Substring(0,35)}},
         CannotChangePassword |
         Sort Department, DaysTill

######################################################################
# REPORT OPTIONS.    UNCOMMENT THE OUTPUT THAT YOU WANT TO USE
######################################################################

# OBJECT OUTPUT THAT CAN BE PLACED IN THE PIPELINE (Includes all selected items above .. feel free to add items to the select statement above)
# $USERLIST

# OUTPUT Grouped by Department OF NAME, PasswordLastSetDate, Days remaining until PW must be changed, the date the change must be made by
#$UserList | Format-Table -Autosize -GroupBy Department -Property SamAccountName, PWlastSetDate, DaysTill, SchedChangeDate

# OUTPUT as above but adding Description, and User PW Can Change Flag
#$UserList | Format-Table -Autosize -GroupBy Department -Property SamAccountName, PWlastSetDate, DaysTill, SchedChangeDate, ShortDescription, CannotChangePassword


# OUTPUT OF NAME, PasswordLastSetDate, Days remaining until PW must be changed, the date the change must be made by
#$UserList | Format-Table -Autosize -Property SamAccountName, Department, PWlastSetDate, DaysTill, SchedChangeDate

# OUTPUT as above but adding Description, and User PW Can Change Flag
$UserList | Format-Table -Autosize -Property SamAccountName, Department, PWlastSetDate, DaysTill, SchedChangeDate, ShortDescription, CannotChangePassword
$UserList | EXPORT-CSV .\PWExpirations.CSV



